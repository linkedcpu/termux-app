<?xml version="1.0" encoding="utf-8"?>
<!--
    ★ 左抽屉内的按钮行（settings / 键盘 / 新建）已移除，抽屉现为空白面板。
    session 切换 / 新建 / 菜单 统一由底部 SessionTabBar + TerminalContextMenu 承担。
-->
<com.termux.app.terminal.TermuxActivityRootView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ========== 终端主体区 ========== -->
    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager">

            <!-- ★ 主内容：必须保持为 DrawerLayout 的第 0 个 child -->
            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <!-- ★ 左抽屉：按钮行已删除，仅保留空白面板 -->
            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground"
                android:paddingTop="8dp">

                <!--
                    ★ settings_button / toggle_keyboard_button / new_session_button 已删除
                    ★ terminal_sessions_list 此前已删除
                    抽屉留白，后续可放 帮助 / 关于 / 清空收藏夹 等入口
                -->
            </LinearLayout>
        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:layout_alignParentBottom="true"
            android:background="@android:color/black"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- ========== 底部栏：Session 标签在此 ========== -->
    <RelativeLayout
        android:id="@+id/tab_bar_root"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:minHeight="32dp"
        android:background="#141414">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/tab_scroll_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="4"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/tab_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/action_group"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_add_button"
                    style="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="＋"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/snippet_button"
                    style="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="☆"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/drawer_menu_button"
                    style="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="≡"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
