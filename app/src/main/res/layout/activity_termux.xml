<?xml version="1.0" encoding="utf-8"?>
<com.termux.app.terminal.TermuxActivityRootView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ========== 终端主体区 ========== -->
    <LinearLayout
        android:id="@+id/activity_termux_root_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 主内容：必须保持为 DrawerLayout 的第 0 个 child -->
            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="0dp"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <!--
                ★ 左抽屉：无 background / 无 outline / 无 clipToOutline
                  圆角·底色·描边由 Theme.surface() 在代码里挂
                  内容由 installDrawerPanel() 动态填充
            -->
            <FrameLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start" />
        </androidx.drawerlayout.widget.DrawerLayout>


    </LinearLayout>

        <!-- ★ 扩展键栏：背景不写死，由 reloadActivityStyling() 套主题 -->
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:visibility="gone" />
    <!-- ========== 底部栏：Session 标签，布局见 session_tab_bar.xml ========== -->
    <include
        android:id="@+id/tab_bar_root"
        layout="@layout/session_tab_bar" />

    <!-- ========== 底部安全区占位 ========== -->
    <Space
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

</com.termux.app.terminal.TermuxActivityRootView>
