<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ 标签上方抽屉菜单
  - 背景由 SessionTabBar.drawerBg() 设置（圆角 + 描边），此处不写死
  - 文字/分隔线颜色由 SessionTabBar.applyDrawerTextColors() 按主题着色
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tab_popup_root"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/item_rename"
        style="@style/TabPopupItem"
        android:text="重命名" />

    <TextView
        android:id="@+id/item_reset"
        style="@style/TabPopupItem"
        android:text="重置终端" />

    <TextView
        android:id="@+id/item_kill"
        style="@style/TabPopupItem"
        android:text="杀死进程" />

    <View
        android:id="@+id/tab_popup_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/item_close"
        style="@style/TabPopupItem"
        android:text="关闭会话" />

</LinearLayout>
